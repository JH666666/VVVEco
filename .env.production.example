# ── 数据库 ────────────────────────────────────────────────────────
DATABASE_URL="file:./prisma/dev.db"

# ── RPC（替换为 Alchemy/Infura 私有 Key，禁止使用公共节点）─────────
BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_BASE_MAINNET_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── WalletConnect ─────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=YOUR_WALLETCONNECT_PROJECT_ID

# ── 管理员 ────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_OWNER_ADDRESS=0x31b265Fd2db6F0445B9d92306a0bf1A313B0aD3A
NEXT_PUBLIC_ROOT_REFERRER_ADDRESS=0x58940A90bc63E72F7F69ad62CA5C776D696b3F5e

# ── Base Mainnet 合约地址（禁止修改）─────────────────────────────
NEXT_PUBLIC_VVV_TOKEN=0xacfe6019ed1a7dc6f7b508c02d1b04ec88cc21bf
NEXT_PUBLIC_VVECO_STAKING=0x5ec768D99Cdc49a95E29811Ce97a313f294EBC64
NEXT_PUBLIC_VVECO_PAYOUT=0x35FAac6Da16345A51437dE4b9a9D0571418fCA36
NEXT_PUBLIC_VVECO_TREASURY=0xcfdca5D4B975BE97321a84160Be89d9dd2f33601

# ── 生产域名 ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://vvveco.io

# ── 后台登录（用宝塔文件管理器填写，禁止提交）────────────────────
ADMIN_ACCOUNT=vvv_admin
ADMIN_PASSWORD=YOUR_STRONG_PASSWORD
ADMIN_SESSION_SECRET=YOUR_RANDOM_SECRET_32CHARS_MIN

# ── 合约操作私钥（仅脚本使用，禁止提交，用宝塔手动填写）──────────
